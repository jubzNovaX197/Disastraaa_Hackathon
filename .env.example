# ─────────────────────────────────────────────────────────────────
# Disastraaa — Environment Configuration Template
# Copy to .env.local and fill in values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────

# App base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Map tile style URLs
# Defaults: CARTO Dark Matter / Positron — openly usable, no API key required.
# Swap for MapTiler/Stadia/custom styles in production.
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Optional: MapTiler API key for higher-quality vector tiles
# NEXT_PUBLIC_MAPTILER_KEY=

# ─────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────

# HMAC signing secret for real-account session cookies.
# REQUIRED in any real deployment — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────
# Authority email verification (Resend)
# ─────────────────────────────────────────────────────────────────

# REQUIRED for real authority registration to send verification emails.
# Get a free API key at https://resend.com
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sandbox sender, which only
# delivers to the Resend account's own verified test address. Verify a
# sending domain in Resend and set this to an address on that domain to
# deliver to arbitrary official emails.
# EMAIL_FROM="Disastraaa <noreply@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────
# Database (Neon PostgreSQL + PostGIS)
# ─────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@ep-something.neon.tech/disastraaa?sslmode=require

# ─────────────────────────────────────────────────────────────────
# NASA FIRMS (Fire Information for Resource Management System)
# ─────────────────────────────────────────────────────────────────
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Optional: if omitted, FIRMS telemetry remains in STANDBY/UNAVAILABLE state.
# NASA_FIRMS_MAP_KEY=

# Optional AI assistant. Without a key, uses deterministic explanations.
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY= (alternative supported name)
# GOOGLE_AI_API_KEY= (alternative supported name)

# Optional GloFAS/CDS hydrology integration (otherwise unavailable)
CDS_API_KEY=

# Optional street basemap
# NEXT_PUBLIC_MAP_STYLE_STREETS_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json

# ─────────────────────────────────────────────────────────────────
# Enterprise Object Storage (S3 / Cloudflare R2 / MinIO)
# ─────────────────────────────────────────────────────────────────
# For archiving raw API snapshots, large GIS datasets, and field evidence.
# If omitted, local server-side storage (.storage/) is used automatically.
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=disastraaa-archive
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_URL=https://assets.disastraaa.gov.in

